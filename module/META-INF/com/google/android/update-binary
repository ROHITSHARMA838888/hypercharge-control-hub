#!/sbin/sh
##########################################################################################
# Rohit's Ultra Fast Charging Mode - Module Installer
# Compatible with KernelSU, Magisk, and APatch
##########################################################################################

umask 022

ui_print() {
  echo "$1"
}

require_root_manager() {
  ui_print "****************************************************"
  ui_print " Please flash via KernelSU, Magisk, or APatch!     "
  ui_print "****************************************************"
  exit 1
}

OUTFD=$2
ZIPFILE=$3

mount /data 2>/dev/null

if [ -f /data/adb/ksu/util_functions.sh ]; then
  . /data/adb/ksu/util_functions.sh
elif [ -f /data/adb/ap/util_functions.sh ]; then
  . /data/adb/ap/util_functions.sh
elif [ -f /data/adb/magisk/util_functions.sh ]; then
  . /data/adb/magisk/util_functions.sh
else
  require_root_manager
fi

install_module
exit 0
